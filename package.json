{
  "name": "@larsottojohnsen/break-my-dashboard",
  "version": "0.1.0",
  "description": "Stress-test local dashboards with Playwright and replayable evidence",
  "type": "module",
  "license": "MIT",
  "author": "Lars Otto Johnsen",
  "repository": {
    "type": "git",
    "url": "https://github.com/Larsottojohnsen/break-my-dashboard.git"
  },
  "bin": {
    "break-my-dashboard": "dist/cli.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "demo",
    "docs/*.md",
    "AGENTS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.mjs tests/policy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "playwright": "1.65.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
